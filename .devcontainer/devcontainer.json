{
  "name": "Lorekeeper",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "pip install uv && uv sync --all-extras --dev",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "Lorekeeper", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "editorconfig.editorconfig"]
    }
  }
}
