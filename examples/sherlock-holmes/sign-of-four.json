  "entities": [
    {
      "id": "holmes",
      "type": "person",
      "from": "ch1.para01",
      "names": [
        {
          "value": "Sherlock Holmes",
          "kind": "primary",
          "from": "ch1.para01"
        }
      ],
      "facets": [
        {
          "id": "sof.holmes.1",
          "from": "ch1.para05",
          "basis": "stated",
          "evidence": [
            "ch1.para01",
            "ch1.para02",
            "ch1.para05"
          ],
          "text": "Has been injecting cocaine several times a day for months when he has no case, which alarms Watson."
        },
        {
          "id": "sof.holmes.2",
          "from": "ch1.para12",
          "basis": "stated",
          "evidence": [
            "ch1.para12"
          ],
          "text": "Calls himself the only unofficial consulting detective, the last resort of official detectives such as Gregson, Lestrade and Athelney Jones; he wants no public credit."
        },
        {
          "id": "sof.holmes.p1",
          "kind": "profile",
          "from": "ch1.para12",
          "basis": "stated",
          "evidence": [
            "ch1.para05",
            "ch1.para12"
          ],
          "replaces": [
            "sis.holmes.p2"
          ],
          "text": "Watson's companion of several years in Baker Street, who calls himself the only unofficial consulting detective and turns to cocaine when he has no problem to work on."
        },
        {
          "id": "sof.holmes.3",
          "from": "ch1.para14",
          "basis": "stated",
          "evidence": [
            "ch1.para13",
            "ch1.para14"
          ],
          "text": "Thinks Watson's written account of their first case was spoiled by romance, since detection should be treated as an exact science."
        },
        {
          "id": "sof.holmes.4",
          "from": "ch1.para22",
          "basis": "stated",
          "evidence": [
            "ch1.para22"
          ],
          "text": "Has written technical monographs, including one that tells apart 140 kinds of tobacco ash."
        },
        {
          "id": "sof.holmes.5",
          "from": "ch1.para30",
          "basis": "stated",
          "evidence": [
            "ch1.para26",
            "ch1.para28",
            "ch1.para30"
          ],
          "text": "Shows the difference between observation and deduction by working out that Watson went to the Wigmore Street post office to send a telegram."
        },
        {
          "id": "sof.holmes.6",
          "from": "ch1.para51",
          "basis": "stated",
          "evidence": [
            "ch1.para37",
            "ch1.para41",
            "ch1.para43",
            "ch1.para44",
            "ch1.para51"
          ],
          "text": "From an old watch alone, deduces the unhappy life of Watson's late elder brother. Watson is hurt until Holmes shows his reasoning."
        },
        {
          "id": "sof.holmes.7",
          "from": "ch2.para35",
          "basis": "stated",
          "evidence": [
            "ch2.para33",
            "ch2.para35"
          ],
          "text": "Insists that a client is only a factor in a problem and that personal feelings must never colour his judgment."
        }
      ]
    },
    {
      "id": "watson",
      "type": "person",
      "from": "ch1.para06",
      "names": [
        {
          "value": "Watson",
          "kind": "alias",
          "from": "ch1.para06"
        }
      ],
      "facets": [
        {
          "id": "sof.watson.1",
          "from": "ch1.para06",
          "basis": "stated",
          "evidence": [
            "ch1.para06"
          ],
          "text": "His health has still not recovered from the Afghan campaign."
        },
        {
          "id": "sof.watson.2",
          "from": "ch1.para13",
          "basis": "stated",
          "evidence": [
            "ch1.para12",
            "ch1.para13"
          ],
          "text": "Has written up the Jefferson Hope case as a short book titled \"A Study in Scarlet\"."
        },
        {
          "id": "sof.watson.3",
          "from": "ch1.para17",
          "basis": "stated",
          "evidence": [
            "ch1.para17"
          ],
          "text": "Has now lived with Holmes in Baker Street for years."
        },
        {
          "id": "sof.watson.4",
          "from": "ch1.para45",
          "basis": "stated",
          "evidence": [
            "ch1.para41",
            "ch1.para43",
            "ch1.para45"
          ],
          "text": "Had an elder brother, now dead, who threw away his prospects and took to drink; the subject is painful to Watson."
        },
        {
          "id": "sof.watson.5",
          "from": "ch2.para40",
          "basis": "stated",
          "evidence": [
            "ch1.para42",
            "ch2.para40"
          ],
          "text": "Describes himself as an army surgeon with a weak leg and very little money, and limps when upset."
        },
        {
          "id": "sof.watson.6",
          "from": "ch2.para40",
          "basis": "stated",
          "evidence": [
            "ch2.para32",
            "ch2.para40"
          ],
          "text": "Is strongly drawn to Mary Morstan but tells himself he has no right to hope."
        }
      ]
    },
    {
      "id": "lestrade",
      "type": "person",
      "from": "ch1.para12",
      "names": [
        {
          "value": "Lestrade",
          "kind": "primary",
          "from": "ch1.para12"
        }
      ],
      "facets": [
        {
          "id": "sof.lestrade.1",
          "from": "ch1.para12",
          "basis": "stated",
          "evidence": [
            "ch1.para12"
          ],
          "text": "Named by Holmes as one of the official detectives who come to him when out of their depth."
        }
      ]
    },
    {
      "id": "gregson",
      "type": "person",
      "from": "ch1.para12",
      "names": [
        {
          "value": "Gregson",
          "kind": "primary",
          "from": "ch1.para12"
        }
      ],
      "facets": [
        {
          "id": "sof.gregson.1",
          "from": "ch1.para12",
          "basis": "stated",
          "evidence": [
            "ch1.para12"
          ],
          "text": "An official detective Holmes names among those who bring him cases."
        }
      ]
    },
    {
      "id": "athelney-jones",
      "type": "person",
      "from": "ch1.para12",
      "names": [
        {
          "value": "Athelney Jones",
          "kind": "primary",
          "from": "ch1.para12"
        }
      ],
      "facets": [
        {
          "id": "sof.jones.1",
          "from": "ch1.para12",
          "basis": "stated",
          "evidence": [
            "ch1.para12"
          ],
          "text": "An official detective Holmes names among those who bring him cases."
        }
      ]
    },
    {
      "id": "le-villard",
      "type": "person",
      "from": "ch1.para18",
      "names": [
        {
          "value": "François Le Villard",
          "kind": "primary",
          "from": "ch1.para18"
        }
      ],
      "facets": [
        {
          "id": "sof.villard.1",
          "from": "ch1.para20",
          "basis": "stated",
          "evidence": [
            "ch1.para18",
            "ch1.para20"
          ],
          "text": "A rising French detective who recently consulted Holmes and is translating Holmes's monographs into French."
        }
      ]
    },
    {
      "id": "mrs-hudson",
      "type": "person",
      "from": "ch1.para55",
      "names": [
        {
          "value": "Mrs. Hudson",
          "kind": "primary",
          "from": "ch1.para55"
        }
      ],
      "facets": [
        {
          "id": "sof.hudson.1",
          "from": "ch1.para55",
          "basis": "stated",
          "evidence": [
            "ch1.para53",
            "ch1.para55"
          ],
          "text": "The landlady at Baker Street, who shows visitors up to Holmes."
        }
      ]
    },
    {
      "id": "mary-morstan",
      "type": "person",
      "from": "ch1.para55",
      "names": [
        {
          "value": "Mary Morstan",
          "kind": "primary",
          "from": "ch1.para55"
        },
        {
          "value": "Miss Morstan",
          "kind": "title",
          "from": "ch2.para01"
        }
      ],
      "facets": [
        {
          "id": "sof.morstan.1",
          "from": "ch1.para55",
          "basis": "stated",
          "evidence": [
            "ch1.para54",
            "ch1.para55"
          ],
          "text": "A young woman who calls on Holmes; he does not recognise her name."
        },
        {
          "id": "sof.morstan.2",
          "from": "ch2.para01",
          "basis": "stated",
          "evidence": [
            "ch2.para01"
          ],
          "text": "Blonde, small and composed, dressed tastefully but plainly in a way that hints at limited means."
        },
        {
          "id": "sof.morstan.3",
          "from": "ch2.para02",
          "basis": "stated",
          "evidence": [
            "ch2.para02"
          ],
          "text": "Employed by Mrs. Cecil Forrester, whom Holmes once helped."
        },
        {
          "id": "sof.morstan.4",
          "from": "ch2.para11",
          "basis": "stated",
          "evidence": [
            "ch2.para09",
            "ch2.para11"
          ],
          "text": "Her mother died when she was young; she grew up at a boarding school in Edinburgh while her father served in India. He vanished in London in 1878, soon after coming home on leave."
        },
        {
          "id": "sof.morstan.5",
          "from": "ch2.para17",
          "basis": "stated",
          "evidence": [
            "ch2.para17"
          ],
          "replaces": [
            "sof.morstan.3"
          ],
          "text": "Has been governess in the household of Mrs. Cecil Forrester since 1882."
        },
        {
          "id": "sof.morstan.6",
          "from": "ch2.para17",
          "basis": "stated",
          "evidence": [
            "ch2.para17"
          ],
          "text": "Since 1882 she has received a valuable pearl by post every year from an unknown sender, after answering a newspaper advertisement that asked for her address."
        },
        {
          "id": "sof.morstan.7",
          "from": "ch2.para20",
          "basis": "stated",
          "evidence": [
            "ch2.para19",
            "ch2.para20"
          ],
          "text": "Has just received an unsigned letter telling her to come to the Lyceum Theatre tonight, with two friends and no police, and promising her justice."
        }
      ]
    },
    {
      "id": "mrs-forrester",
      "type": "person",
      "from": "ch2.para02",
      "names": [
        {
          "value": "Mrs. Cecil Forrester",
          "kind": "primary",
          "from": "ch2.para02"
        }
      ],
      "facets": [
        {
          "id": "sof.forrester.1",
          "from": "ch2.para03",
          "basis": "stated",
          "evidence": [
            "ch2.para02",
            "ch2.para03"
          ],
          "text": "Mary Morstan's employer and a former client of Holmes, whose problem he remembers as a simple one."
        }
      ]
    },
    {
      "id": "captain-morstan",
      "type": "person",
      "from": "ch2.para09",
      "names": [
        {
          "value": "Captain Morstan",
          "kind": "primary",
          "from": "ch2.para09"
        }
      ],
      "facets": [
        {
          "id": "sof.capt.1",
          "from": "ch2.para11",
          "basis": "stated",
          "evidence": [
            "ch2.para09",
            "ch2.para11"
          ],
          "text": "Mary's father, senior captain of an Indian regiment, who disappeared from the Langham Hotel in London on 3 December 1878 and was never heard of again."
        },
        {
          "id": "sof.capt.2",
          "from": "ch2.para13",
          "basis": "stated",
          "evidence": [
            "ch2.para13"
          ],
          "text": "Had served as an officer of the convict guard on the Andaman Islands; his abandoned luggage held curiosities from there."
        }
      ]
    },
    {
      "id": "andaman-islands",
      "type": "place",
      "from": "ch2.para13",
      "names": [
        {
          "value": "Andaman Islands",
          "kind": "primary",
          "from": "ch2.para13"
        }
      ],
      "facets": [
        {
          "id": "sof.andaman.1",
          "from": "ch2.para13",
          "basis": "stated",
          "evidence": [
            "ch2.para13"
          ],
          "text": "Islands where Captain Morstan helped guard convicts."
        }
      ]
    },
    {
      "id": "major-sholto",
      "type": "person",
      "from": "ch2.para15",
      "names": [
        {
          "value": "Major Sholto",
          "kind": "primary",
          "from": "ch2.para15"
        }
      ],
      "facets": [
        {
          "id": "sof.sholto.1",
          "from": "ch2.para15",
          "basis": "stated",
          "evidence": [
            "ch2.para15"
          ],
          "text": "Captain Morstan's only known friend in London: a retired officer of his regiment living at Upper Norwood, who said he had not known Morstan was in England."
        }
      ]
    },
    {
      "id": "pearls",
      "type": "object",
      "from": "ch2.para17",
      "names": [
        {
          "value": "Mary Morstan's pearls",
          "kind": "descriptive",
          "from": "ch2.para17"
        }
      ],
      "facets": [
        {
          "id": "sof.pearls.1",
          "from": "ch2.para17",
          "basis": "stated",
          "evidence": [
            "ch2.para17"
          ],
          "text": "Six rare, valuable pearls, one posted to Mary each year since 1882 with no note or sender."
        }
      ]
    },
    {
      "id": "lyceum",
      "type": "place",
      "from": "ch2.para20",
      "names": [
        {
          "value": "Lyceum Theatre",
          "kind": "primary",
          "from": "ch2.para20"
        }
      ],
      "facets": [
        {
          "id": "sof.lyceum.1",
          "from": "ch2.para20",
          "basis": "stated",
          "evidence": [
            "ch2.para20"
          ],
          "text": "London theatre where the letter tells Mary to wait at a particular pillar at seven o'clock tonight."
        }
      ]
    }
  ],
