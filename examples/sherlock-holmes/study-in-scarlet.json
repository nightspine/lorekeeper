  "entities": [
    {
      "id": "watson",
      "type": "person",
      "from": "pt1.note",
      "names": [
        {
          "value": "John H. Watson",
          "kind": "primary",
          "from": "pt1.note"
        },
        {
          "value": "Watson",
          "kind": "alias",
          "from": "ch1.para06"
        },
        {
          "value": "Dr. Watson",
          "kind": "title",
          "from": "ch1.para35"
        }
      ],
      "facets": [
        {
          "id": "sis.watson.1",
          "from": "ch1.para01",
          "basis": "stated",
          "evidence": [
            "pt1.note",
            "ch1.para01"
          ],
          "text": "The narrator. Qualified as a doctor in London in 1878 and joined the army as an assistant surgeon, reaching his regiment in the Second Afghan War."
        },
        {
          "id": "sis.watson.2",
          "from": "ch1.para02",
          "basis": "stated",
          "evidence": [
            "ch1.para02"
          ],
          "text": "Hit in the shoulder by a Jezail bullet at the battle of Maiwand; his orderly Murray got him back to British lines."
        },
        {
          "id": "sis.watson.3",
          "from": "ch1.para03",
          "basis": "stated",
          "evidence": [
            "ch1.para03"
          ],
          "text": "Nearly died of enteric fever while recovering in Peshawar and was shipped home to England with his health ruined."
        },
        {
          "id": "sis.watson.4",
          "from": "ch1.para09",
          "basis": "stated",
          "evidence": [
            "ch1.para04",
            "ch1.para09"
          ],
          "text": "Alone in London with no family and a small army pension, he is running short of money and looking for cheaper lodgings."
        },
        {
          "id": "sis.watson.p1",
          "kind": "profile",
          "from": "ch1.para09",
          "basis": "stated",
          "evidence": [
            "ch1.para01",
            "ch1.para02",
            "ch1.para03",
            "ch1.para09"
          ],
          "text": "The narrator: an army doctor sent home from Afghanistan after a wound at Maiwand and a bad fever, now alone in London with a small pension and little money."
        },
        {
          "id": "sis.watson.5",
          "from": "ch1.para57",
          "basis": "stated",
          "evidence": [
            "ch1.para57"
          ],
          "text": "Owns up to keeping a bull pup, having frayed nerves, rising at odd hours and being very lazy."
        },
        {
          "id": "sis.watson.6",
          "from": "ch2.para04",
          "basis": "stated",
          "evidence": [
            "ch2.para03",
            "ch2.para04"
          ],
          "text": "With poor health, no visitors and little to do, he becomes absorbed in trying to work out who Holmes really is."
        },
        {
          "id": "sis.watson.7",
          "from": "ch2.para44",
          "basis": "stated",
          "evidence": [
            "ch2.para44"
          ],
          "text": "Suspects that Holmes's confident deductions are bluster that cannot be checked."
        }
      ]
    },
    {
      "id": "murray",
      "type": "person",
      "from": "ch1.para02",
      "names": [
        {
          "value": "Murray",
          "kind": "primary",
          "from": "ch1.para02"
        }
      ],
      "facets": [
        {
          "id": "sis.murray.1",
          "from": "ch1.para02",
          "basis": "stated",
          "evidence": [
            "ch1.para02"
          ],
          "text": "Watson's orderly at Maiwand, who saved him by throwing him across a pack-horse and carrying him to safety."
        }
      ]
    },
    {
      "id": "maiwand",
      "type": "place",
      "from": "ch1.para02",
      "names": [
        {
          "value": "Maiwand",
          "kind": "primary",
          "from": "ch1.para02"
        }
      ],
      "facets": [
        {
          "id": "sis.maiwand.1",
          "from": "ch1.para02",
          "basis": "stated",
          "evidence": [
            "ch1.para02"
          ],
          "text": "Battle of the Second Afghan War where Watson was badly wounded."
        }
      ]
    },
    {
      "id": "stamford",
      "type": "person",
      "from": "ch1.para05",
      "names": [
        {
          "value": "Stamford",
          "kind": "primary",
          "from": "ch1.para05"
        }
      ],
      "facets": [
        {
          "id": "sis.stamford.1",
          "from": "ch1.para05",
          "basis": "stated",
          "evidence": [
            "ch1.para05"
          ],
          "text": "Once a dresser under Watson at Barts; the two run into each other by chance at the Criterion Bar."
        },
        {
          "id": "sis.stamford.2",
          "from": "ch1.para35",
          "basis": "stated",
          "evidence": [
            "ch1.para33",
            "ch1.para35"
          ],
          "text": "Takes Watson to the hospital laboratory and introduces him to Sherlock Holmes."
        }
      ]
    },
    {
      "id": "barts",
      "type": "place",
      "from": "ch1.para05",
      "names": [
        {
          "value": "Barts",
          "kind": "primary",
          "from": "ch1.para05"
        }
      ],
      "facets": [
        {
          "id": "sis.barts.1",
          "from": "ch1.para05",
          "basis": "stated",
          "evidence": [
            "ch1.para05"
          ],
          "text": "The London hospital where Watson and Stamford once worked together."
        },
        {
          "id": "sis.barts.2",
          "from": "ch1.para34",
          "basis": "stated",
          "evidence": [
            "ch1.para33",
            "ch1.para34"
          ],
          "text": "Holmes works in its chemical laboratory, a high room crowded with bottles, retorts and test-tubes."
        }
      ]
    },
    {
      "id": "criterion-bar",
      "type": "place",
      "from": "ch1.para05",
      "names": [
        {
          "value": "Criterion Bar",
          "kind": "primary",
          "from": "ch1.para05"
        }
      ],
      "facets": [
        {
          "id": "sis.criterion.1",
          "from": "ch1.para05",
          "basis": "stated",
          "evidence": [
            "ch1.para05"
          ],
          "text": "The London bar where Watson meets Stamford again."
        }
      ]
    },
    {
      "id": "holmes",
      "type": "person",
      "from": "ch1.para14",
      "names": [
        {
          "value": "Sherlock Holmes",
          "kind": "primary",
          "from": "ch1.para14"
        },
        {
          "value": "Holmes",
          "kind": "alias",
          "from": "ch1.para27"
        }
      ],
      "facets": [
        {
          "id": "sis.holmes.1",
          "from": "ch1.para14",
          "basis": "stated",
          "evidence": [
            "ch1.para12",
            "ch1.para14"
          ],
          "text": "A man Stamford knows from the hospital's chemical laboratory, who is looking for someone to split the cost of a set of rooms."
        },
        {
          "id": "sis.holmes.2",
          "from": "ch1.para18",
          "basis": "stated",
          "evidence": [
            "ch1.para18"
          ],
          "text": "Knows anatomy well and is a first-rate chemist, yet has never studied medicine systematically; even Stamford does not know his aims."
        },
        {
          "id": "sis.holmes.p1",
          "kind": "profile",
          "from": "ch1.para18",
          "basis": "stated",
          "evidence": [
            "ch1.para14",
            "ch1.para18"
          ],
          "text": "A young man who works in the hospital's chemical laboratory: a first-class chemist who knows anatomy well but follows no regular course of study, and who wants someone to share rooms with."
        },
        {
          "id": "sis.holmes.3",
          "from": "ch1.para31",
          "basis": "stated",
          "evidence": [
            "ch1.para27",
            "ch1.para29",
            "ch1.para31"
          ],
          "text": "Stamford finds him scientific to the point of coldness: he has been seen beating corpses in the dissecting rooms to study bruising after death."
        },
        {
          "id": "sis.holmes.4",
          "from": "ch1.para37",
          "basis": "stated",
          "evidence": [
            "ch1.para36",
            "ch1.para37"
          ],
          "text": "On first meeting Watson, tells him he has been in Afghanistan, and will not say how he knew."
        },
        {
          "id": "sis.holmes.5",
          "from": "ch1.para40",
          "basis": "stated",
          "evidence": [
            "ch1.para38",
            "ch1.para40"
          ],
          "text": "Has just discovered a reagent that reacts to haemoglobin, giving a reliable test for bloodstains, and is thrilled by its value in criminal cases."
        },
        {
          "id": "sis.holmes.6",
          "from": "ch1.para56",
          "basis": "stated",
          "evidence": [
            "ch1.para52",
            "ch1.para54",
            "ch1.para56"
          ],
          "text": "Warns Watson that he smokes strong tobacco, keeps chemicals and runs experiments at home, and sometimes falls silent for days."
        },
        {
          "id": "sis.holmes.7",
          "from": "ch2.para03",
          "basis": "stated",
          "evidence": [
            "ch2.para03"
          ],
          "text": "Over six feet tall and very lean, with piercing eyes, a hawk-like nose, a square chin, and hands stained by ink and chemicals."
        },
        {
          "id": "sis.holmes.8",
          "from": "ch2.para05",
          "basis": "stated",
          "evidence": [
            "ch2.para05"
          ],
          "text": "His profession is a mystery to Watson: he is not studying medicine or working toward any degree, yet his knowledge in certain areas is deep and exact."
        },
        {
          "id": "sis.holmes.9",
          "from": "ch2.para06",
          "basis": "stated",
          "evidence": [
            "ch2.para06"
          ],
          "text": "Knows next to nothing of literature, philosophy or politics, and did not know that the earth goes round the sun."
        },
        {
          "id": "sis.holmes.10",
          "from": "ch2.para11",
          "basis": "stated",
          "evidence": [
            "ch2.para07",
            "ch2.para09",
            "ch2.para11"
          ],
          "text": "Treats the mind as an attic with limited room, so he deliberately forgets anything that is no use to his work."
        },
        {
          "id": "sis.holmes.11",
          "from": "ch2.para14",
          "basis": "stated",
          "evidence": [
            "ch2.para14"
          ],
          "text": "Watson's list of his knowledge: none in literature, philosophy or astronomy; profound in chemistry; immense in sensational crime; also a fine violinist, boxer, swordsman and singlestick player who knows British law."
        },
        {
          "id": "sis.holmes.12",
          "from": "ch2.para17",
          "basis": "stated",
          "evidence": [
            "ch2.para17"
          ],
          "text": "Receives a stream of very different visitors he calls clients, borrowing the shared sitting-room to see them."
        },
        {
          "id": "sis.holmes.13",
          "from": "ch2.para24",
          "basis": "stated",
          "evidence": [
            "ch2.para19",
            "ch2.para21",
            "ch2.para24"
          ],
          "text": "Turns out to be the author of the magazine article on observation that Watson has just mocked."
        },
        {
          "id": "sis.holmes.14",
          "from": "ch2.para28",
          "basis": "stated",
          "evidence": [
            "ch2.para28"
          ],
          "replaces": [
            "sis.holmes.8"
          ],
          "text": "Works as a consulting detective, perhaps the only one in the world: police and private detectives bring him cases they cannot solve."
        },
        {
          "id": "sis.holmes.p2",
          "kind": "profile",
          "from": "ch2.para28",
          "basis": "stated",
          "evidence": [
            "ch2.para03",
            "ch2.para28"
          ],
          "replaces": [
            "sis.holmes.p1"
          ],
          "text": "Watson's fellow lodger in Baker Street: a tall, very lean man with sharp eyes and a beak of a nose, who earns his living as a consulting detective, reasoning from small observed details to firm conclusions."
        },
        {
          "id": "sis.holmes.15",
          "from": "ch2.para34",
          "basis": "stated",
          "evidence": [
            "ch2.para34"
          ],
          "text": "Explains that he read Watson's army bearing, tanned face, fair wrists, haggard look and stiff arm in an instant to place him in Afghanistan."
        },
        {
          "id": "sis.holmes.16",
          "from": "ch2.para38",
          "basis": "stated",
          "evidence": [
            "ch2.para36",
            "ch2.para38"
          ],
          "text": "Scorns the famous fictional detectives Dupin and Lecoq."
        },
        {
          "id": "sis.holmes.17",
          "from": "ch2.para50",
          "basis": "stated",
          "evidence": [
            "ch2.para43",
            "ch2.para50"
          ],
          "text": "Identifies a messenger across the street as a retired Marine sergeant; the man confirms it."
        }
      ]
    },
    {
      "id": "baker-street",
      "type": "place",
      "from": "ch1.para52",
      "names": [
        {
          "value": "Baker Street",
          "kind": "primary",
          "from": "ch1.para52"
        },
        {
          "value": "221B Baker Street",
          "kind": "primary",
          "from": "ch2.para01"
        }
      ],
      "facets": [
        {
          "id": "sis.bakerst.1",
          "from": "ch1.para52",
          "basis": "stated",
          "evidence": [
            "ch1.para52"
          ],
          "text": "Holmes has his eye on a suite of rooms here that would suit two lodgers."
        },
        {
          "id": "sis.bakerst.2",
          "from": "ch2.para01",
          "basis": "stated",
          "evidence": [
            "ch2.para01"
          ],
          "text": "Two bedrooms and a bright, well-furnished sitting-room. Holmes and Watson take the rooms on the spot and move in."
        }
      ]
    },
    {
      "id": "blood-test",
      "type": "concept",
      "from": "ch1.para40",
      "names": [
        {
          "value": "Holmes's bloodstain test",
          "kind": "descriptive",
          "from": "ch1.para40"
        }
      ],
      "facets": [
        {
          "id": "sis.bloodtest.1",
          "from": "ch1.para40",
          "basis": "stated",
