    {
      "id": "watson",
      "type": "person",
      "from": "toc05.para06",
      "names": [
        {
          "value": "Watson",
          "kind": "primary",
          "from": "toc05.para06"
        }
      ],
      "facets": [
        {
          "id": "study-in-scarlet.watson.1",
          "from": "toc05.para06",
          "basis": "stated",
          "evidence": [
            "toc05.para06"
          ],
          "text": "A man who is thin and brown from his experiences in Afghanistan."
        },
        {
          "id": "study-in-scarlet.watson.2",
          "from": "toc05.para06",
          "basis": "stated",
          "evidence": [
            "toc05.para01"
          ],
          "text": "He earned a Doctor of Medicine degree from the University of London in 1878."
        },
        {
          "id": "study-in-scarlet.watson.3",
          "from": "toc05.para06",
          "basis": "stated",
          "evidence": [
            "toc05.para03"
          ],
          "text": "He was granted nine months by the government to recover his ruined health."
        },
        {
          "id": "study-in-scarlet.watson.4",
          "from": "toc05.para06",
          "basis": "stated",
          "evidence": [
            "toc05.para04"
          ],
          "text": "He is currently struggling with a dwindling income of eleven shillings and sixpence a day."
        },
        {
