    {
      "id": "sherlock-holmes",
      "type": "person",
      "from": "toc05.para01",
      "names": [
        {
          "value": "Sherlock Holmes",
          "kind": "primary",
          "from": "toc05.para01"
        },
        {
          "value": "consulting detective",
          "kind": "alias",
          "from": "toc06.para28"
        }
      ],
      "facets": [
        {
          "id": "study-in-scarlet.sherlock-holmes.1",
          "from": "toc05.para35",
          "basis": "stated",
          "evidence": [
            "toc05.para35"
          ],
          "text": "A man who works in a chemical laboratory and has a passion for exact knowledge."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.2",
          "from": "toc05.para18",
          "basis": "stated",
          "evidence": [
            "toc05.para18"
          ],
          "text": "He is described as having desultory and eccentric studies but possessing vast out-of-the-way knowledge."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.3",
          "from": "toc05.para27",
          "basis": "stated",
          "evidence": [
            "toc05.para27"
          ],
          "text": "He is noted for his cold-blooded, scientific nature and a passion for definite knowledge."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.4",
          "from": "toc05.para29",
          "basis": "stated",
          "evidence": [
            "toc05.para29"
          ],
          "text": "He was observed beating subjects in a dissecting-room with a stick to verify bruises."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.5",
          "from": "toc05.para40",
          "basis": "stated",
          "evidence": [
            "toc05.para40"
          ],
          "text": "He discovered a chemical reagent that can infallibly detect blood stains."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.6",
          "from": "toc05.para50",
          "basis": "stated",
          "evidence": [
            "toc05.para50"
          ],
          "text": "He admits to dabbling with poisons and has hands mottled with acid and plaster."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.7",
          "from": "toc05.para56",
          "basis": "stated",
          "evidence": [
            "toc05.para56"
          ],
          "text": "He admits to becoming moody and silent for days at a time."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.8",
          "from": "toc05.para52",
          "basis": "stated",
          "evidence": [
            "toc05.para52"
          ],
          "text": "He intends to share a suite in Baker Street with Watson."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.9",
          "from": "toc05.para66",
          "basis": "stated",
          "evidence": [
            "toc05.para66"
          ],
          "text": "He has a peculiar ability to find out information about people."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.10",
          "from": "toc05.para52",
          "basis": "stated",
          "evidence": [
            "toc05.para52"
          ],
          "text": "He asks if Watson minds the smell of strong tobacco."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.11",
          "from": "toc05.para54",
          "basis": "stated",
          "evidence": [
            "toc05.para54"
          ],
          "text": "He asks if Watson would be annoyed by his chemicals and experiments."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.12",
          "from": "toc05.para62",
          "basis": "stated",
          "evidence": [
            "toc05.para62"
          ],
          "text": "He invites Watson to see the rooms the following day at noon."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.13",
          "from": "toc06.para02",
          "basis": "stated",
          "evidence": [
            "toc06.para02"
          ],
          "text": "Holmes is a quiet man with regular habits who spends time in a laboratory, dissecting-rooms, or on long walks."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.14",
          "from": "toc06.para02",
          "basis": "stated",
          "evidence": [
            "toc06.para02"
          ],
          "text": "He experiences periods of intense energy followed by days of lying motionless on a sofa with a vacant expression."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.15",
          "from": "toc06.para03",
          "basis": "stated",
          "evidence": [
            "toc06.para03"
          ],
          "text": "He is over six feet tall, excessively lean, and possesses sharp eyes, a hawk-like nose, and a square chin."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.16",
          "from": "toc06.para03",
          "basis": "stated",
          "evidence": [
            "toc06.para03"
          ],
          "text": "Despite his ink-stained and chemical-stained hands, he possesses an extraordinary delicacy of touch."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.17",
          "from": "toc06.para05",
          "basis": "stated",
          "evidence": [
            "toc06.para05"
          ],
          "text": "Holmes possesses an extraordinarily ample and minute knowledge of specific subjects despite not studying medicine or science."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.18",
          "from": "toc06.para06",
          "basis": "stated",
          "evidence": [
            "toc06.para06"
          ],
          "text": "He is remarkably ignorant of contemporary literature, philosophy, politics, the Copernican Theory, and the Solar System."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.19",
          "from": "toc06.para09",
          "basis": "stated",
          "evidence": [
            "toc06.para09"
          ],
          "text": "He views the human brain as an attic that should only be stocked with useful tools for one's specific work."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.20",
          "from": "toc06.para14",
          "basis": "stated",
          "evidence": [
            "toc06.para14"
          ],
          "text": "Watson notes Holmes has no knowledge of literature, philosophy, or astronomy, but is proficient in botany, geology, chemistry, and anatomy."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.21",
          "from": "toc06.para14",
          "basis": "stated",
          "evidence": [
            "toc06.para14"
          ],
          "text": "Holmes is an expert in sensational literature, a skilled violinist, a boxer, a swordsman, and a singlestick player."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.22",
          "from": "toc06.para14",
          "basis": "stated",
          "evidence": [
            "toc06.para14"
          ],
          "text": "He possesses a good practical knowledge of British law."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.23",
          "from": "toc06.para16",
          "basis": "stated",
          "evidence": [
            "toc06.para16"
          ],
          "text": "He plays the violin with great skill, often producing melancholy or cheerful chords that reflect his internal thoughts."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.24",
          "from": "toc06.para17",
          "basis": "stated",
          "evidence": [
            "toc06.para17"
          ],
          "text": "Holmes has many acquaintances from various social classes who visit him as clients."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.25",
          "from": "toc06.para24",
          "basis": "stated",
          "evidence": [
            "toc06.para24"
          ],
          "text": "Holmes reveals that he is the author of the article regarding the Science of Deduction."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.26",
          "from": "toc06.para28",
          "basis": "stated",
          "evidence": [
            "toc06.para26",
            "toc06.para28"
          ],
          "text": "He describes himself as a consulting detective who helps government and private detectives solve crimes."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.27",
          "from": "toc06.para28",
          "basis": "stated",
          "evidence": [
            "toc06.para28"
          ],
          "text": "Holmes uses his knowledge of the history of crime to help others unravel complex cases."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.28",
          "from": "toc06.para32",
          "basis": "stated",
          "evidence": [
            "toc06.para32"
          ],
          "text": "He claims to have a kind of intuition and states that observation is second nature to him."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.29",
          "from": "toc06.para34",
          "basis": "stated",
          "evidence": [
            "toc06.para34"
          ],
          "text": "Holmes explains how he deduced Watson's history in Afghanistan through a rapid train of reasoning."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.30",
          "from": "toc06.para40",
          "basis": "stated",
          "evidence": [
            "toc06.para40"
          ],
          "text": "Holmes expresses frustration that there are few crimes worth his talents, calling most criminal acts bungling."
        },
        {
          "id": "study-in-scarlet.sherlock-holmes.31",
          "from": "toc06.para43",
          "basis": "stated",
          "evidence": [
            "toc06.para43"
          ],
          "text": "Holmes correctly identifies a passerby as a retired sergeant of Marines based on his appearance."
        }
      ]
    },
