  "recaps": [
    {
      "id": "study-in-scarlet.recap.1",
      "from": "toc05.para69",
      "text": "After serving as a surgeon in the Afghan war, Dr. Watson returned to England with ruined health and limited funds. While seeking affordable lodgings in London, he met an old acquaintance named Stamford. Stamford suggested that Watson share a room with a man named Sherlock Holmes, a scientific and eccentric individual. Watson visited Holmes at a laboratory, where they discussed Holmes's new blood-testing discovery. The two men agreed to inspect a suite in Baker Street together the following day.",
      "evidence": [
        "toc05.para69"
      ]
    },
    {
      "id": "study-in-scarlet.recap.2",
      "from": "toc06.para51",
      "text": "Watson and Holmes move into a suite at 221b Baker Street and begin to settle in. Watson becomes fascinated by Holmes's eccentric habits, vast but specific knowledge, and physical appearance. After Watson mocks an article on the Science of Deduction, Holmes reveals he is the author and explains his role as a consulting detective. Holmes demonstrates his powers of observation by deducing Watson's military history and identifying a passerby on the street. The passage concludes with a man delivering a letter to Holmes, confirming his professional status.",
      "evidence": [
        "toc06.para51"
      ]
    }
  ],
