  "recaps": [
    {
      "id": "study-in-scarlet.recap.1",
      "from": "toc05.para69",
      "text": "In 1878 Watson, a newly qualified army surgeon, was wounded at Maiwand in the Afghan war and sent home from Peshawar with ruined health. Living in London on a small income, he met his former dresser Stamford, who introduced him to Sherlock Holmes, an eccentric chemist at the hospital. Holmes showed Watson a new blood-detection test and, after a brief exchange of habits, they agreed to share rooms in Baker Street. Holmes also astonished Watson by somehow knowing he had come from Afghanistan.",
      "evidence": [
        "toc05.para69"
      ]
    },
    {
      "id": "study-in-scarlet.recap.2",
      "from": "toc06.para51",
      "text": "In 1878 Watson, a newly qualified army surgeon wounded at Maiwand in the Afghan war, was sent home with ruined health. In London he met his former dresser Stamford, who introduced him to Sherlock Holmes, an eccentric chemist. They agreed to share rooms at 221b Baker Street, where Holmes astonished Watson by knowing he had come from Afghanistan. Holmes lives regularly but erratically, and many visitors come to consult him in private. Holmes reveals he is a consulting detective who sorts out cases for police and private agents.",
      "evidence": [
        "toc06.para51"
      ]
    }
